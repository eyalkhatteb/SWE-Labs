<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.swelabs.LoginController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <TextField fx:id="usernameField" promptText="Email"/>
    <Label fx:id="errorLabel" textFill="RED" wrapText="true" textAlignment="CENTER"/>
    <PasswordField fx:id="passwordField" promptText="Password"/>
    <Button fx:id="loginButton" text="login" onAction="#onLoginButtonClick"/>
    <Button fx:id="syncTestButton" text="run sync test" onAction="#onSyncTestButtonClick"/>
    <Label fx:id="syncTestLabel" wrapText="true" textAlignment="CENTER"/>
</VBox>
